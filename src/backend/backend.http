@backend_HostAddress = http://localhost:5112
@accessToken = replace-with-jwt
@refreshToken = replace-with-refresh-token
@clientId = 01JV0EXAMPLECLIENT000000000

### Login
POST {{backend_HostAddress}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "teamlead@example.com",
  "password": "ChangeMe123!"
}

### Current user
GET {{backend_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Refresh token
POST {{backend_HostAddress}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Logout
POST {{backend_HostAddress}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Clients list for ToolJet table
GET {{backend_HostAddress}}/clients?page=1&pageSize=20&search=&sortBy=name&sortDir=asc
Authorization: Bearer {{accessToken}}
Accept: application/json

### Clients select options
GET {{backend_HostAddress}}/clients/select?search=alex&limit=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Client detail for ToolJet form
GET {{backend_HostAddress}}/clients/{{clientId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create client
POST {{backend_HostAddress}}/clients
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "Alex Example",
  "emails": [
    { "email": "alex@example.com", "isPrimary": true },
    { "email": "alex.work@example.com", "isPrimary": false }
  ],
  "contacts": {
    "phoneNumber": "+380501112233",
    "telegram": "@alexexample",
    "discord": "alexexample",
    "instagram": "@alex.insta"
  },
  "financials": {
    "initialBudget": 1000,
    "totalEarnings": 0
  },
  "additionalInfo": {
    "notes": "Lead from webinar",
    "preferredLanguage": "en",
    "source": "webinar",
    "city": "Kyiv",
    "birthDate": "1995-04-12",
    "occupation": "Designer"
  },
  "createdBy": "tooljet"
}

### Update client
PUT {{backend_HostAddress}}/clients/{{clientId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "Alex Example Updated",
  "emails": [
    { "email": "alex@example.com", "isPrimary": false },
    { "email": "alex.updated@example.com", "isPrimary": true }
  ],
  "contacts": {
    "phoneNumber": "+380509998877",
    "telegram": "@alexexample",
    "discord": "alexexample",
    "instagram": "@alex.insta"
  },
  "financials": {
    "initialBudget": 1200,
    "totalEarnings": 300
  },
  "additionalInfo": {
    "notes": "Updated from ToolJet form",
    "preferredLanguage": "en",
    "source": "referral",
    "city": "Warsaw",
    "birthDate": "1995-04-12",
    "occupation": "Product Designer"
  }
}

### Patch client
PATCH {{backend_HostAddress}}/clients/{{clientId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "contacts": {
    "telegram": "@alexexample_updated"
  }
}

### Set primary email
POST {{backend_HostAddress}}/clients/{{clientId}}/primary-email
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "email": "alex.updated@example.com"
}

### Add client email
POST {{backend_HostAddress}}/clients/{{clientId}}/emails
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "email": "alex.new@example.com",
  "isPrimary": false
}

### Products list
GET {{backend_HostAddress}}/products?page=1&pageSize=20&search=&sortBy=name&sortDir=asc
Authorization: Bearer {{accessToken}}
Accept: application/json

### Product detail
GET {{backend_HostAddress}}/products/1
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create product
POST {{backend_HostAddress}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "code": "crypto-mentorship",
  "legacyCode": "CM-001",
  "name": "Crypto Mentorship",
  "type": "Mentorship",
  "discordAccess": true
}

### Patch product
PATCH {{backend_HostAddress}}/products/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "isActive": true,
  "isArchived": false
}

### Add package to product
POST {{backend_HostAddress}}/products/1/packages
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "code": "crypto-mentorship-base",
  "name": "Base Package",
  "durationDays": 30,
  "discordAccess": true,
  "discordDays": 30
}

### Orders list
GET {{backend_HostAddress}}/orders?page=1&pageSize=20&sortBy=createdAt&sortDir=desc
Authorization: Bearer {{accessToken}}
Accept: application/json

### Order detail
GET {{backend_HostAddress}}/orders/{{clientId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create order
POST {{backend_HostAddress}}/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "clientId": "{{clientId}}",
  "source": "Manual",
  "items": [
    {
      "productId": 1,
      "packageId": 1,
      "price": 1000,
      "quantity": 1
    }
  ],
  "payments": [
    {
      "amount": 1000,
      "currency": "USD",
      "status": "Pending",
      "totalInstallments": 1
    }
  ]
}

### Patch order
PATCH {{backend_HostAddress}}/orders/{{clientId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "Active"
}

### Add payment to order
POST {{backend_HostAddress}}/orders/{{clientId}}/payments
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "amount": 500,
  "currency": "USD",
  "status": "Paid",
  "totalInstallments": 1,
  "paidAt": "2026-06-03T12:00:00Z"
}

### Subscriptions list
GET {{backend_HostAddress}}/subscriptions?page=1&pageSize=20&sortBy=startAt&sortDir=desc
Authorization: Bearer {{accessToken}}
Accept: application/json

### Subscription detail
GET {{backend_HostAddress}}/subscriptions/{{clientId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create subscription
POST {{backend_HostAddress}}/subscriptions
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "clientId": "{{clientId}}",
  "productId": 1,
  "orderItemId": "{{clientId}}",
  "startAt": "2026-06-01T00:00:00Z",
  "endAt": "2026-07-01T00:00:00Z",
  "type": "CoursePlatform",
  "status": "Active",
  "notes": "Created from ToolJet"
}

### Patch subscription
PATCH {{backend_HostAddress}}/subscriptions/{{clientId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "notes": "Updated note from ToolJet"
}

### Change subscription status
POST {{backend_HostAddress}}/subscriptions/{{clientId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "Suspended"
}

